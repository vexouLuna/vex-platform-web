{
  "name": "@vex/platform-web",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "description": "Web side of vex-platform: a client for its /api/v2 jobs and audit, Vue components for them, and Twitch chat rendering (emotes, badges, colours)",
  "repository": "github:vexouLuna/vex-platform-web",
  "sideEffects": [
    "*.css",
    "./dist/vue.js"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./chat": {
      "types": "./dist/types/chat/index.d.ts",
      "import": "./dist/chat.js"
    },
    "./vue": {
      "types": "./dist/types/vue/index.d.ts",
      "import": "./dist/vue.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "story:dev": "histoire dev",
    "story:build": "histoire build",
    "prepare": "npm run build",
    "changeset": "changeset",
    "release": "changeset version"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@histoire/plugin-vue": "^1.0.0-beta.1",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "histoire": "^1.0.0-beta.1",
    "typescript": "~7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.12"
  },
  "engines": {
    "node": ">=22"
  }
}
